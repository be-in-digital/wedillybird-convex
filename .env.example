# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Super admin — identifiant auto-promu en role=admin à la connexion.
# Deux voies indépendantes : le téléphone promeut à la connexion OTP
# (`convex/auth.ts:verifyOtp`), l'e-mail au magic link (`verifyMagicLink`).
# Poser les deux si l'on se connecte tantôt par l'un, tantôt par l'autre —
# chacune ne couvre QUE son propre chemin d'authentification.
# Les valeurs sont normalisées avant comparaison (`06 12 …` et `Hello@…`
# fonctionnent), mais l'égalité reste exacte après normalisation.
# À poser sur le déploiement, pas ici :
#   pnpx convex env set ADMIN_PHONE +33600000000
#   pnpx convex env set ADMIN_EMAIL admin@exemple.com
ADMIN_PHONE=+33600000000
ADMIN_EMAIL=admin@exemple.com

# Session cookie HMAC (>= 32 chars, openssl rand -hex 32)
SESSION_SECRET=

# WhatsApp Cloud API (mock si absents)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=otp_code
# WhatsApp Business Account ID — requis pour soumettre des templates custom à Meta
# (pas le phone number ID). Trouvé via Meta Business Suite → WhatsApp Manager.
# WHATSAPP_WABA_ID=
# Webhook Meta (configuré dans Meta Developer Console → Webhooks)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Override le nom du template UTILITY utilisé pour notifier les couples
# (cf. scripts/submit-whatsapp-templates.ts → template_status_update).
# WHATSAPP_TEMPLATE_STATUS_TEMPLATE=template_status_update
# Templates UTILITY de rappels J-7 / J-1 envoyés aux invités (cron quotidien
# `convex/reminders.ts`). Tant que ces templates ne sont pas validés côté Meta
# Business Manager, l'absence de ces env vars provoque un fallback email-only
# dans le cron — l'envoi WhatsApp est skip avec un warning.
# WHATSAPP_REMINDER_D7_TEMPLATE=wedding_reminder_d7
# WHATSAPP_REMINDER_D1_TEMPLATE=wedding_reminder_d1

# Twilio SMS (canal US/Canada — mock si absents, cf. convex/lib/twilioSms.ts)
# Routage par pays dans convex/lib/channelRouting.ts : un numéro dont l'indicatif
# est dans SMS_COUNTRY_CODES (défaut "+1") part en SMS Twilio, le reste en WhatsApp.
# Le SMS ne s'active QUE si TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + un sender
# (Messaging Service OU numéro From) sont posés. Sinon fallback WhatsApp — zéro
# régression tant que le numéro toll-free + la Toll-Free Verification ne sont pas live.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Préférer le Messaging Service (pool de senders, sélection par pays) au numéro fixe.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+1...
# Liste CSV des indicatifs routés vers le SMS (défaut "+1" = US + Canada).
# Étendre sans toucher au code, ex. "+1,+44".
# SMS_COUNTRY_CODES=+1
# Nom de marque préfixant l'OTP SMS (défaut "Wedillybird").
# SMS_BRAND_NAME=Wedillybird

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret du webhook Connect (BYOP) — REQUIS en prod pour la réconciliation des
# liens de paiement / budget : ces encaissements sont des charges directes sur les
# comptes connectés des agences, dont les événements arrivent sur un endpoint
# webhook Connect SÉPARÉ (secret propre). Le code essaie d'abord STRIPE_WEBHOOK_SECRET
# (plateforme) puis celui-ci. Sans lui, les paiements ne se réconcilient pas en prod.
# (Dashboard Stripe → Développeurs → Webhooks → endpoint « comptes connectés ».)
STRIPE_CONNECT_WEBHOOK_SECRET=

# Secret partagé Vercel ⇄ Convex pour autoriser le bridge webhook
# `organizations:updateSubscriptionFromWebhook` (fix sécurité F-01,
# audit avril 2026). À poser dans les DEUX env (Vercel et Convex) avec la
# MEME valeur. Générer via `openssl rand -hex 32`.
CONVEX_WEBHOOK_SECRET=

# Secret des Vercel Cron Jobs (`vercel.json` → `crons`), qui protège
# `/api/cron/reconcile-payments` (T2-2) et `/api/cron/entitlement-audit`
# (T2-8). Vercel ajoute automatiquement le header
# `Authorization: Bearer $CRON_SECRET` à l'appel du cron dès que cette
# variable est posée côté Vercel (Production) — rien à faire côté code au
# déploiement. Générer via `openssl rand -hex 32`. Sans elle, ces deux routes
# rejettent TOUT appel (401), pas de fallback silencieux.
CRON_SECRET=

# Stripe Prices — grille canonique multi-devises (cf. .context/redesign-direction.md)
# Générer / synchroniser via : pnpx tsx scripts/sync-stripe-prices.ts
# Convention : STRIPE_PRICE_<PLAN>[_ANNUAL]_<CURRENCY> avec CURRENCY ∈ {EUR, MAD, TND}.
# Le nom legacy sans suffix devise (STRIPE_PRICE_ESSENTIAL=…) reste un alias EUR.
# B2C particuliers (one-shot)
# STRIPE_PRICE_ESSENTIAL_EUR=
# STRIPE_PRICE_ESSENTIAL_MAD=
# STRIPE_PRICE_ESSENTIAL_TND=
# STRIPE_PRICE_PREMIUM_EUR=
# STRIPE_PRICE_PREMIUM_MAD=
# STRIPE_PRICE_PREMIUM_TND=
# STRIPE_PRICE_POST_EVENT_UPSELL_EUR=
# STRIPE_PRICE_POST_EVENT_UPSELL_MAD=
# STRIPE_PRICE_POST_EVENT_UPSELL_TND=
# Pros — abonnement mensuel
# STRIPE_PRICE_STARTER_EUR=
# STRIPE_PRICE_STARTER_MAD=
# STRIPE_PRICE_STARTER_TND=
# STRIPE_PRICE_BUSINESS_EUR=
# STRIPE_PRICE_BUSINESS_MAD=
# STRIPE_PRICE_BUSINESS_TND=
# STRIPE_PRICE_AGENCY_EUR=
# STRIPE_PRICE_AGENCY_MAD=
# STRIPE_PRICE_AGENCY_TND=
# Pros — abonnement annuel (-20%)
# STRIPE_PRICE_STARTER_ANNUAL_EUR=
# STRIPE_PRICE_STARTER_ANNUAL_MAD=
# STRIPE_PRICE_STARTER_ANNUAL_TND=
# STRIPE_PRICE_BUSINESS_ANNUAL_EUR=
# STRIPE_PRICE_BUSINESS_ANNUAL_MAD=
# STRIPE_PRICE_BUSINESS_ANNUAL_TND=
# STRIPE_PRICE_AGENCY_ANNUAL_EUR=
# STRIPE_PRICE_AGENCY_ANNUAL_MAD=
# STRIPE_PRICE_AGENCY_ANNUAL_TND=
# Pro Pay-as-you-go (one-shot, 1 event)
# STRIPE_PRICE_PAYG_EVENT_EUR=
# STRIPE_PRICE_PAYG_EVENT_MAD=
# STRIPE_PRICE_PAYG_EVENT_TND=
# Aliases legacy (rétro-compat — résolus comme alias EUR si _EUR manque)
# STRIPE_PRICE_ESSENTIAL=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_POST_EVENT_UPSELL=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_AGENCY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# STRIPE_PRICE_AGENCY_ANNUAL=
# STRIPE_PRICE_PAYG_EVENT=

# Forcer le driver mock pour paiements en E2E
# PAYMENTS_DRIVER=mock

# AWS (IAM user wedillybird-dev avec AdministratorAccess en dev)
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# SES
SES_FROM_ADDRESS=noreply@wedillybird.com
SES_CONFIGURATION_SET=wedillybird-default
EMAIL_DRIVER=ses
# Forcer le driver mock pour tests/E2E
# EMAIL_DRIVER=mock

# S3 + CloudFront (rempli après cdk deploy)
# S3_BUCKET=wedillybird-media-prod
# CLOUDFRONT_DOMAIN=media.wedillybird.com

# Lambda HMAC pour callbacks Convex
# LAMBDA_CALLBACK_SECRET=

# OpenAI Moderation API (gratuit, conçu pour la modération de contenu).
# Si défini, le Lambda Rekognition appelle aussi cette API en sortie pour un
# double-check sémantique multimodal qui rattrape les illustrations / dessins
# que Rekognition Moderation Labels rate. Skip silencieux si absent.
# OPENAI_API_KEY=sk-…

# Demo bypass — pour le tournage de la vidéo de lancement (seed `sarah-marc-launch-demo`).
# Si DEMO_BYPASS_PHONE matche EXACTEMENT le téléphone passé à `auth.requestOtp` et que
# DEMO_BYPASS_CODE est un OTP 6 digits, l'action skip l'envoi WhatsApp et persiste
# directement le code attendu. Le `verifyOtp` standard fait foi (rate limit, expiry,
# attempts). Ne JAMAIS poser ces env vars sur le déploiement prod.
#   pnpx convex env set DEMO_BYPASS_PHONE +33600000001
#   pnpx convex env set DEMO_BYPASS_CODE 424242
# DEMO_BYPASS_PHONE=
# DEMO_BYPASS_CODE=

# E2E test mode — force tous les drivers (WhatsApp + email) en mock, même
# si les credentials sont définis. Activé automatiquement par playwright.config
# côté webServer et doit être posé côté env Convex avant les tests E2E :
#   pnpx convex env set E2E_MODE 1
#   pnpm exec playwright test
#   pnpx convex env unset E2E_MODE
# Ne JAMAIS activer ce flag en prod.
# E2E_MODE=1

# PostHog — analytics produit & marketing
# Deux niveaux : mesure sans cookie pour tous (cookieless_mode 'on_reject' —
# à ACTIVER dans PostHog → Project settings → « Cookieless server hash mode »,
# sinon ces events sont ignorés), replay/heatmaps/profil après consentement.
# Token public du projet (PostHog → Project settings). Le client passe par le
# reverse proxy /ingest (next.config.ts) ; le SDK serveur posthog-node utilise
# POSTHOG_HOST direct (us.i.posthog.com US cloud, eu.i.posthog.com EU cloud).
# À reporter aussi côté Vercel (Production + Preview) pour l'analytics en prod.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Clé PERSONNELLE (scope query:read) pour LIRE les données dans /admin/acquisition
# (PostHog → Settings → Personal API keys). Sans elle, la page admin affiche un
# encart de configuration au lieu des graphiques. Host de l'API : us.posthog.com.
POSTHOG_PERSONAL_API_KEY=

# Pixel Meta (Facebook/Instagram Ads) — pour optimiser et retargeter les pubs.
# ID depuis Meta Events Manager (business.facebook.com/events_manager). Vide =
# pixel totalement inerte. Chargé uniquement après consentement RGPD (comme PostHog).
NEXT_PUBLIC_META_PIXEL_ID=
